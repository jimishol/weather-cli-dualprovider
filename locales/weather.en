#!/usr/bin/env bash
# locales/weather.en.sh
# English locale for weather-cli-dualprovider
# Descriptions are original text written for this project. Numeric codes follow WMO.
# LOCALE_VERSION helps detect incompatible changes
LOCALE_VERSION="1"

# WMO code → English description
declare -A DESC_FOR_WMO=(
  [0]="Sunny"
  [1]="Mostly sunny"
  [2]="Some clouds"
  [3]="Cloudy"
  [45]="Haze"
  [48]="Rime fog"
  [51]="Very light drip"
  [53]="Light drip"
  [55]="Dripping"
  [56]="Icy drip"
  [57]="Heavy icy drip"
  [61]="Fine drizzle"
  [63]="Light rain"
  [65]="Heavy rain"
  [66]="Icy rain"
  [67]="Severe icy rain"
  [71]="Fine snow"
  [73]="Light snow"
  [75]="Heavy snow"
  [77]="Snow grains"
  [80]="Light showers"
  [81]="Moderate showers"
  [82]="Strong showers"
  [85]="Light snow showers"
  [86]="Heavy snow showers"
  [95]="Thunder"
  [96]="Thunder, small hail"
  [99]="Thunder, large hail"
)

# Localized static labels used in tooltip and messages
LABEL_SUNRISE="Sunrise"
LABEL_SUNSET="Sunset"
LABEL_FEELS="Feels like"
LABEL_RAIN="Rain"
LABEL_PROVIDER_WTTR="wttr.in"
LABEL_PROVIDER_OPENMETEO="Open‑Meteo"
LABEL_UNKNOWN="Unknown"
